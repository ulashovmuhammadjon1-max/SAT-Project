# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local file storage for uploaded PDFs
/storage/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
__pycache__/
prod_math_stems.json
_dump_prod.mjs

# Agent scratch space. The explanation-authoring agents write helper scripts
# and extracted figures here; each namespaces its own subdirectory after two
# agents clobbered a shared filename. None of it is work product — the actual
# output is content-pool/explanations/out/*.jsonl, which IS committed.
scratchpad/
# Rendered book pages: regenerable from the source PDFs on demand by
# dump_q.py, and several hundred PNGs do not belong in git history.
content-pool/satoplam-math/pages/
content-pool/satoplam-math/render.log

# IELTS speaking recordings written by local dev
/storage/ielts-audio/
/storage/ielts-images/
