// SAT Platform database schema
// Postgres, accessed through Prisma Client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth v5 - Prisma adapter shape) + platform roles
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  ADMIN
}

/// Answers collected by the pre-signup onboarding wizard. Stored on the user
/// so the dashboard can personalise itself and the admin panel can report on
/// audience composition (country mix, grade mix, score targets).
enum OnboardingGoal {
  IMPROVE_SCORE
  FIRST_SAT
  RETAKING
  COLLEGE_ADMISSIONS
}

enum GradeLevel {
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
  GAP_YEAR
  COLLEGE
  OTHER
}

enum DailyGoalType {
  QUESTIONS
  MINUTES
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // streak / gamification
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?

  // onboarding profile (all optional — accounts created before the wizard
  // existed, and admin accounts, simply have none of it)
  onboardingGoal     OnboardingGoal?
  currentScore       Int?
  targetScore        Int?
  dreamUniversities  String[]        @default([])
  countryCode        String?
  gradeLevel         GradeLevel?
  satDate            DateTime?
  strongestSection   String?
  weakestArea        String?
  studyMinutesPerDay Int?
  dailyGoalType      DailyGoalType?
  dailyGoalValue     Int?
  onboardedAt        DateTime?

  // --- Legal ------------------------------------------------------------
  /// When this account accepted the Terms and Privacy Policy, and which
  /// version. A checkbox nobody records proves nothing later, so the
  /// acceptance is stored rather than merely enforced in the form.
  /// Null on accounts created before the checkbox existed.
  termsAcceptedAt DateTime?
  termsVersion    String?

  // --- SATForge Coins ---------------------------------------------------
  // Cached balance for fast reads. The CoinTransaction ledger is the record
  // of truth; this column is only ever written inside the same transaction
  // that writes a ledger row (see lib/coins.ts).
  coinBalance Int @default(0)

  // --- Referrals --------------------------------------------------------
  /// Stable public code used in ?ref= links. Assigned on first use rather
  /// than at signup so existing accounts backfill lazily.
  referralCode     String? @unique
  /// Who referred this account, if anyone. Denormalised from Referral for
  /// cheap "was this user referred" checks and self-referral guarding.
  referredById     String?
  referredBy       User?   @relation("ReferredAccounts", fields: [referredById], references: [id], onDelete: SetNull)
  referredAccounts User[]  @relation("ReferredAccounts")

  accounts Account[]
  sessions Session[]

  attempts         Attempt[]
  bookmarks        Bookmark[]
  questionAttempts QuestionAttempt[]
  bookings         Booking[]
  /// Bookings this user (an admin) approved, rejected or cancelled.
  bookingDecisions Booking[]         @relation("BookingDecider")

  /// Telegram identity, set once the student signs in through the Login Widget.
  /// Stored as a string rather than BigInt: ids can exceed 2^53 and this value
  /// is only ever passed straight back to Telegram, never used in arithmetic.
  telegramUserId    String?             @unique
  telegramUsername  String?
  telegramLinkedAt  DateTime?
  /// Last known channel membership and when it was established. Cached because
  /// the admin queue would otherwise call Telegram once per row on every render.
  telegramIsMember  Boolean             @default(false)
  telegramCheckedAt DateTime?
  vocabProgress     VocabProgress[]
  vocabSetProgress  VocabDeckProgress[]
  studyActivities   StudyActivity[]
  chatThreads       ChatThread[]
  auditLogs         AuditLog[]

  coinTransactions    CoinTransaction[] @relation("CoinLedgerOwner")
  coinAdjustmentsMade CoinTransaction[] @relation("CoinLedgerActor")
  referralsMade       Referral[]        @relation("ReferralsMade")
  referralReceived    Referral?         @relation("ReferralReceived")
  studyPlan           StudyPlan?
  platformSettings    PlatformSetting[] @relation("PlatformSettingUpdatedBy")

  communityMessages  CommunityMessage[]  @relation("CommunityMessages")
  communityMentions  CommunityMention[]  @relation("CommunityMentions")
  communityReads     CommunityRead[]     @relation("CommunityReads")
  communityReactions CommunityReaction[] @relation("CommunityReactions")

  uploadsCreated     PDFUpload[]       @relation("UploadedBy")
  uploadsReviewed    AIProcessingJob[] @relation("ReviewedBy")
  testsCreated       Test[]            @relation("TestCreatedBy")
  vocabWordsCreated  VocabWord[]       @relation("VocabCreatedBy")
  announcementsMade  Announcement[]    @relation("AnnouncementCreatedBy")
  adaptiveConfigsSet AdaptiveConfig[]  @relation("AdaptiveConfigUpdatedBy")

  @@index([role])
  @@index([countryCode])
  @@index([gradeLevel])
  @@index([onboardedAt])
  @@index([referredById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Curriculum taxonomy
// ---------------------------------------------------------------------------

enum Subject {
  READING_WRITING
  MATH
}

model Domain {
  id          String  @id @default(cuid())
  subject     Subject
  name        String
  code        String  @unique // e.g. "INI", "CAS", "EOI", "SEC", "ALG", "ADV", "PSDA", "GT"
  description String?
  order       Int     @default(0)

  skills    Skill[]
  questions Question[]

  @@index([subject])
}

model Skill {
  id          String  @id @default(cuid())
  domainId    String
  name        String
  code        String  @unique
  description String?
  order       Int     @default(0)

  domain    Domain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([domainId])
}

// ---------------------------------------------------------------------------
// Tests / adaptive modules
// ---------------------------------------------------------------------------

enum TestType {
  FULL_LENGTH
  PRACTICE_SET
  CUSTOM_QUIZ
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ModuleDifficulty {
  STANDARD // module 1 (or non-adaptive module)
  EASY // module 2, lower branch
  HARD // module 2, upper branch
}

model Test {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        TestType   @default(FULL_LENGTH)
  status      TestStatus @default(DRAFT)
  isAdaptive  Boolean    @default(true)

  adaptiveConfigId String?
  adaptiveConfig   AdaptiveConfig? @relation(fields: [adaptiveConfigId], references: [id])

  createdById String?
  createdBy   User?   @relation("TestCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules  Module[]
  attempts Attempt[]

  @@index([status, type])
}

model Module {
  id                   String           @id @default(cuid())
  testId               String
  subject              Subject
  order                Int // 1 or 2
  difficulty           ModuleDifficulty @default(STANDARD)
  title                String?
  timeLimitMinutes     Int              @default(32)
  // overrides the test-level adaptive config threshold when set
  adaptiveThresholdPct Int?

  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  passages  Passage[]
  questions Question[]

  moduleAttempts ModuleAttempt[]

  @@unique([testId, subject, order, difficulty])
  @@index([testId])
}

model Passage {
  id       String  @id @default(cuid())
  moduleId String?
  title    String?
  content  String  @db.Text // HTML/rich text
  imageUrl String?
  source   String?

  module    Module?    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([moduleId])
}

enum QuestionType {
  MULTIPLE_CHOICE
  FREE_RESPONSE // student-produced response (grid-in), math only
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id              String             @id @default(cuid())
  moduleId        String?
  passageId       String?
  domainId        String
  skillId         String
  type            QuestionType       @default(MULTIPLE_CHOICE)
  difficulty      QuestionDifficulty @default(MEDIUM)
  stem            String             @db.Text // HTML
  imageUrl        String?
  tableData       Json?
  order           Int                @default(0)
  points          Int                @default(1)
  correctAnswerFR String? // accepted answer(s) for free-response, JSON-encoded list as string
  isPublished     Boolean            @default(false)
  source          String? // e.g. "AI_EXTRACTED", "MANUAL"
  sourceUploadId  String?

  module  Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  passage Passage? @relation(fields: [passageId], references: [id], onDelete: SetNull)
  domain  Domain   @relation(fields: [domainId], references: [id])
  skill   Skill    @relation(fields: [skillId], references: [id])

  choices          AnswerChoice[]
  explanation      Explanation?
  responses        Response[]
  bookmarks        Bookmark[]
  questionAttempts QuestionAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@index([domainId, skillId])
  @@index([difficulty])
}

model AnswerChoice {
  id         String  @id @default(cuid())
  questionId String
  label      String // "A" | "B" | "C" | "D"
  content    String  @db.Text
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question  Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses Response[]

  @@index([questionId])
}

enum ExplanationSource {
  MANUAL
  AI_GENERATED
}

model Explanation {
  id              String            @id @default(cuid())
  questionId      String            @unique
  content         String            @db.Text
  whyCorrect      String?           @db.Text
  whyWrongJson    Json? // { [choiceId]: string }
  commonMistakes  String?           @db.Text
  tips            String?           @db.Text
  relatedConcepts String?           @db.Text
  source          ExplanationSource @default(MANUAL)
  generatedAt     DateTime?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Attempts / responses
// ---------------------------------------------------------------------------

enum AttemptStatus {
  IN_PROGRESS
  PAUSED
  SUBMITTED
  ABANDONED
}

model Attempt {
  id     String        @id @default(cuid())
  userId String
  testId String
  status AttemptStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  pausedAt    DateTime?

  currentModuleId String?

  module1ScorePct      Float?
  assignedModule2Level ModuleDifficulty?

  totalScaledScore Int?
  mathScaledScore  Int?
  rwScaledScore    Int?

  duplicateOfAttemptId String?
  duplicateOf          Attempt?  @relation("AttemptDuplicate", fields: [duplicateOfAttemptId], references: [id])
  duplicates           Attempt[] @relation("AttemptDuplicate")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  test Test @relation(fields: [testId], references: [id])

  moduleAttempts ModuleAttempt[]
  responses      Response[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([testId])
}

model ModuleAttempt {
  id        String @id @default(cuid())
  attemptId String
  moduleId  String

  startedAt        DateTime  @default(now())
  submittedAt      DateTime?
  timeSpentSeconds Int       @default(0)
  correctCount     Int       @default(0)
  totalCount       Int       @default(0)
  scaledScore      Int?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id])

  @@unique([attemptId, moduleId])
}

model Response {
  id              String @id @default(cuid())
  attemptId       String
  moduleAttemptId String
  questionId      String

  selectedChoiceId    String?
  freeResponseAnswer  String?
  isCorrect           Boolean?
  timeSpentSeconds    Int       @default(0)
  changedAnswerCount  Int       @default(0)
  flagged             Boolean   @default(false)
  eliminatedChoiceIds Json? // string[]
  order               Int       @default(0)
  answeredAt          DateTime?

  attempt        Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question      @relation(fields: [questionId], references: [id])
  selectedChoice AnswerChoice? @relation(fields: [selectedChoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([moduleAttemptId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  note       String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

/// A single answer submitted in the Question Bank (untimed, outside a test).
///
/// Deliberately separate from `Response`, which is scoped to a test `Attempt`
/// and `ModuleAttempt` and must keep its exam semantics. A student may answer
/// the same question many times here, so rows accumulate — "attempted" means
/// *distinct* questionIds, and Question Bank progress reads both this table
/// and `Response` so work done inside a mock still counts.
model QuestionAttempt {
  id                 String   @id @default(cuid())
  userId             String
  questionId         String
  selectedChoiceId   String?
  freeResponseAnswer String?
  isCorrect          Boolean
  timeSpentSeconds   Int      @default(0)
  createdAt          DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, questionId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Free 1:1 mentorship booking
// ---------------------------------------------------------------------------

enum BookingStatus {
  /// Booked by the student, seat and coins held, waiting on an admin decision.
  PENDING
  /// Approved. This is what "confirmed" means to a student.
  UPCOMING
  COMPLETED
  /// Withdrawn after it existed — by the student, or by an admin after approval.
  CANCELLED
  /// Turned down by an admin before it was ever confirmed.
  REJECTED
}

/// What kind of session a slot/booking is.
///
/// SATForge will run financial-literacy classes, expert lectures and weekly
/// test-analysis sessions alongside 1-on-1 guidance, so the booking system is
/// typed from the start rather than hard-coded to SAT tutoring.
enum SessionType {
  ONE_ON_ONE_SAT
  TEST_ANALYSIS
  FINANCIAL_LITERACY
  LECTURE
  WORKSHOP
}

/// A bookable slot published by a mentor/admin.
///
/// Stored as an absolute UTC instant; the student UI renders it in their own
/// timezone. `isBlocked` lets an admin retire a slot without deleting history.
model MentorSlot {
  id              String   @id @default(cuid())
  startsAt        DateTime
  durationMinutes Int      @default(30)
  isBlocked       Boolean  @default(false)
  note            String?
  createdAt       DateTime @default(now())

  sessionType SessionType @default(ONE_ON_ONE_SAT)
  /// Seats. 1 keeps the existing 1-on-1 semantics; a lecture can open many.
  capacity    Int         @default(1)
  /// Shown on the events page. Null for plain 1-on-1 slots, which need no name.
  title       String?
  description String?     @db.Text

  bookings Booking[]

  @@unique([startsAt])
  @@index([startsAt])
}

model Booking {
  id     String        @id @default(cuid())
  userId String
  slotId String
  status BookingStatus @default(UPCOMING)

  // Snapshot of what the student told us at booking time. Copied rather than
  // read live off User so the mentor sees what was actually submitted.
  name              String
  email             String
  currentScore      Int?
  targetScore       Int?
  satDate           DateTime?
  studyHoursPerWeek Int?
  weakestArea       String?
  notes             String?   @db.Text
  timezone          String? // IANA zone captured from the browser, for display

  sessionType SessionType @default(ONE_ON_ONE_SAT)

  /// Coins actually charged, snapshotted at booking time. Stored rather than
  /// recomputed because the price ladder depends on how many bookings the
  /// student had made *then*, and because a refund must return exactly what
  /// was taken even if the ladder or the settings have since changed.
  coinCost Int @default(0)

  /// When the student attested to the community follow/join requirements.
  /// An attestation, not a verified fact — see lib/community.ts.
  requirementsAckAt DateTime?

  /// Meeting join URL from whichever provider created it, and the provider's
  /// own id so a booking can later be reconciled or cancelled upstream.
  meetingUrl        String?
  meetingProvider   String?
  meetingExternalId String?

  /// What an admin typed when approving, rejecting or cancelling. Shown to the
  /// student in the decision email and on My Sessions, so it is student-facing
  /// prose, not an internal note.
  statusReason String?   @db.Text
  /// When an admin last approved/rejected/cancelled, and who did it. Kept even
  /// if that admin is later deleted, hence SetNull rather than Cascade.
  decidedAt    DateTime?
  decidedById  String?

  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?      @relation("BookingDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  slot      MentorSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  coinTransactions CoinTransaction[]

  /// A student can hold at most one booking per slot. This replaces the old
  /// `slotId @unique`, which capped every slot at one attendee and made group
  /// events impossible. Capacity is now enforced inside the booking
  /// transaction under a row lock on the slot — see createBooking.
  @@unique([slotId, userId])
  @@index([userId, status])
  @@index([status])
  @@index([slotId, status])
  @@index([sessionType, status])
}

// ---------------------------------------------------------------------------
// Vocabulary
// ---------------------------------------------------------------------------

enum VocabDifficulty {
  EASY
  MEDIUM
  HARD
}

enum VocabStatus {
  NEW
  LEARNING
  MASTERED
}

enum VocabVisibility {
  PUBLIC // admin-curated, visible to every student
  PRIVATE // added by a student for their own personal study list
}

// A named source book/package (e.g. "College Panda 400 Words", "Ivy Global
// 500 Words"). Each collection contains its own gated sequence of sets.
model VocabCollection {
  id          String   @id @default(cuid())
  name        String
  description String?
  order       Int?
  createdAt   DateTime @default(now())

  decks VocabDeck[]

  @@index([order])
}

model VocabDeck {
  id           String   @id @default(cuid())
  name         String
  description  String?
  order        Int? // sequence position within its collection (e.g. "Set 1".."Set 16"); null = not part of a gated sequence
  passageTitle String?
  passage      String?  @db.Text
  createdAt    DateTime @default(now())

  collectionId String?
  collection   VocabCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  words         VocabDeckWord[]
  quizQuestions VocabSetQuizQuestion[]
  progress      VocabDeckProgress[]

  @@unique([collectionId, order])
  @@index([order])
}

model VocabSetQuizQuestion {
  id      String @id @default(cuid())
  deckId  String
  order   Int
  stem    String @db.Text
  choiceA String @db.Text
  choiceB String @db.Text
  choiceC String @db.Text
  choiceD String @db.Text
  correct String // "A" | "B" | "C" | "D"

  deck VocabDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([deckId, order])
}

// Per-user completion state for a gated VocabDeck ("set"). A set counts as
// passed once its quiz is cleared at or above the required score, which is
// what unlocks the next set in the sequence.
model VocabDeckProgress {
  id          String    @id @default(cuid())
  userId      String
  deckId      String
  bestScore   Int       @default(0)
  attempts    Int       @default(0)
  passed      Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck VocabDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([userId, deckId])
}

model VocabWord {
  id              String          @id @default(cuid())
  term            String
  partOfSpeech    String?
  definition      String          @db.Text
  exampleSentence String?         @db.Text
  difficulty      VocabDifficulty @default(MEDIUM)
  synonyms        Json? // string[]
  antonyms        Json? // string[]
  audioUrl        String?
  imageUrl        String?
  visibility      VocabVisibility @default(PUBLIC)

  createdById    String?
  createdBy      User?   @relation("VocabCreatedBy", fields: [createdById], references: [id])
  sourceUploadId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decks    VocabDeckWord[]
  progress VocabProgress[]

  @@index([difficulty])
  @@index([term])
  @@index([visibility])
}

model VocabDeckWord {
  deckId String
  wordId String
  order  Int    @default(0)

  deck VocabDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([deckId, wordId])
}

// Spaced repetition progress per user/word (SM-2 style)
model VocabProgress {
  id     String @id @default(cuid())
  userId String
  wordId String

  status         VocabStatus @default(NEW)
  easeFactor     Float       @default(2.5)
  intervalDays   Int         @default(0)
  repetitions    Int         @default(0)
  correctStreak  Int         @default(0)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  isBookmarked   Boolean     @default(false)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, nextReviewAt])
}

// ---------------------------------------------------------------------------
// PDF ingestion / AI processing pipeline
// ---------------------------------------------------------------------------

enum UploadCategory {
  FULL_TEST
  QUESTION_BANK
  VOCABULARY
}

enum UploadStatus {
  PENDING
  PROCESSING
  NEEDS_REVIEW
  COMPLETED
  FAILED
}

model PDFUpload {
  id       String         @id @default(cuid())
  fileName String
  fileUrl  String
  fileSize Int
  category UploadCategory
  status   UploadStatus   @default(PENDING)

  uploadedById String?
  uploadedBy   User?   @relation("UploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs AIProcessingJob[]

  @@index([status, category])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model AIProcessingJob {
  id       String    @id @default(cuid())
  uploadId String
  status   JobStatus @default(QUEUED)

  startedAt       DateTime?
  completedAt     DateTime?
  confidenceScore Float? // 0-1, overall extraction confidence
  extractedData   Json? // structured extraction result awaiting review
  errorMessage    String?   @db.Text
  logs            Json? // step-by-step trace for the admin queue view

  reviewedById String?
  reviewedBy   User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  publishedAt  DateTime?

  upload PDFUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([status])
  @@index([uploadId])
}

// ---------------------------------------------------------------------------
// Adaptive engine configuration (admin-editable)
// ---------------------------------------------------------------------------

model AdaptiveConfig {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(false)

  // % correct on module 1 at/above which a student routes to the HARD module 2
  rwThresholdPct   Int @default(70)
  mathThresholdPct Int @default(70)

  updatedById String?
  updatedBy   User?    @relation("AdaptiveConfigUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  tests Test[]
}

// ---------------------------------------------------------------------------
// Platform admin: feature flags, announcements, activity, audit, AI chat
// ---------------------------------------------------------------------------

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  isEnabled   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

enum AnnouncementAudience {
  ALL
  STUDENT
  ADMIN
}

model Announcement {
  id        String               @id @default(cuid())
  title     String
  body      String               @db.Text
  audience  AnnouncementAudience @default(ALL)
  isActive  Boolean              @default(true)
  expiresAt DateTime?

  createdById String?
  createdBy   User?   @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}

// per-day activity used for streaks + heatmaps
model StudyActivity {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime @db.Date
  questionsAnswered Int      @default(0)
  minutesStudied    Int      @default(0)
  vocabReviewed     Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
}

// Future feature: AI tutor / review-mode chat assistant
enum ChatRole {
  USER
  ASSISTANT
}

model ChatThread {
  id         String   @id @default(cuid())
  userId     String
  questionId String?
  attemptId  String?
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// SATForge Coins — engagement currency
//
// Coins are internal, not money, and must never be mutated from the client.
// `User.coinBalance` is the fast read used by the UI; `CoinTransaction` is the
// ledger of record and every balance change writes one. `balanceAfter` is
// stamped on each row so the ledger can be replayed and reconciled against the
// cached balance without recomputing a running sum in the client.
// ---------------------------------------------------------------------------

enum CoinTxnType {
  SIGNUP_BONUS
  REFERRAL_REWARD
  BOOKING_SPEND
  BOOKING_REFUND
  ADMIN_ADJUSTMENT
  PROMOTION
}

model CoinTransaction {
  id           String      @id @default(cuid())
  userId       String
  /// Signed: +15 for a referral reward, -10 for a booking. Never 0.
  amount       Int
  type         CoinTxnType
  /// The user's balance immediately after this row was written, inside the
  /// same transaction that wrote it.
  balanceAfter Int
  description  String

  /// Set for BOOKING_SPEND / BOOKING_REFUND. SetNull rather than Cascade: the
  /// ledger must survive the deletion of what it refers to.
  bookingId  String?
  referralId String?
  /// The admin who made an ADMIN_ADJUSTMENT.
  actorId    String?

  /// Guards against a retried action double-crediting. Callers derive a stable
  /// key from the event ("signup:<userId>", "referral:<referralId>"), so a
  /// second attempt violates the unique index instead of paying twice.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  user     User      @relation("CoinLedgerOwner", fields: [userId], references: [id], onDelete: Cascade)
  actor    User?     @relation("CoinLedgerActor", fields: [actorId], references: [id], onDelete: SetNull)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  referral Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type])
}

enum ReferralStatus {
  /// Code was attributed at signup; reward not yet paid.
  PENDING
  /// Reward paid.
  REWARDED
  /// Rejected by an abuse rule, or reversed by an admin.
  VOID
}

/// One row per referred account. `referredUserId` is unique, so an account can
/// only ever be counted once no matter how many times a code is replayed.
model Referral {
  id             String         @id @default(cuid())
  referrerId     String
  referredUserId String         @unique
  code           String
  status         ReferralStatus @default(PENDING)
  rewardedAt     DateTime?
  /// Why an abuse rule voided this, for admin review.
  voidReason     String?
  createdAt      DateTime       @default(now())

  referrer     User @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferralReceived", fields: [referredUserId], references: [id], onDelete: Cascade)

  coinTransactions CoinTransaction[]

  @@index([referrerId, status])
  @@index([code])
}

/// Admin-tunable platform values (booking base cost and increment, referral
/// reward, signup bonus, community handles, refund policy).
///
/// Key/value rather than columns so a new knob does not need a migration, and
/// so `lib/settings.ts` can hold the defaults and the parsing in one place.
model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?
  updatedBy   User?    @relation("PlatformSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Personalized study plan
// ---------------------------------------------------------------------------

/// A cached snapshot of the generated plan.
///
/// The plan is DERIVED from the student's profile plus their live question
/// performance, so it is recomputed rather than edited. This table exists so
/// the dashboard does not re-run the aggregation on every render, and so
/// milestone completion has somewhere to live. `evidenceCount` records how
/// many graded answers the snapshot was built from — when that number moves,
/// the plan is stale and gets rebuilt.
model StudyPlan {
  id     String @id @default(cuid())
  userId String @unique

  /// The rendered plan (weeks, focus areas, milestones). Shape owned by
  /// `lib/plan/types.ts`.
  data Json

  targetScore   Int?
  currentScore  Int?
  testDate      DateTime?
  /// Graded answers the snapshot was computed from.
  evidenceCount Int       @default(0)
  generatedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Community chat
//
// Channel-based discussion between students. Messages are plain text, stored
// unrendered: the client escapes and linkifies at display time, so a message
// can never inject markup into another student's page. Mentions are resolved
// server-side into rows rather than being parsed out of the body on every
// read, which keeps "who was tagged" answerable without re-scanning text.
//
// Deletion is soft. A hard delete would tear replies out of their context and
// leave dangling "replying to a deleted message" threads with no way to show
// that something was removed; `deletedAt` keeps the shape of the conversation
// while hiding the content.
// ---------------------------------------------------------------------------

model CommunityChannel {
  id          String  @id @default(cuid())
  /// URL segment: /community/<slug>
  slug        String  @unique
  name        String
  description String?
  /// Display order in the channel list.
  order       Int     @default(0)
  /// Announcements: admins post, students read.
  isReadOnly  Boolean @default(false)
  isArchived  Boolean @default(false)

  createdAt DateTime @default(now())

  messages CommunityMessage[]
  reads    CommunityRead[]

  @@index([isArchived, order])
}

model CommunityMessage {
  id        String @id @default(cuid())
  channelId String
  authorId  String

  /// Raw text as typed. Never HTML — see the note above.
  body String @db.Text

  /// The message this one replies to. SetNull rather than Cascade so deleting
  /// a parent does not silently erase every reply under it.
  replyToId String?
  replyTo   CommunityMessage?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   CommunityMessage[] @relation("MessageReply")

  editedAt    DateTime?
  deletedAt   DateTime?
  /// Who removed it — the author themselves, or a moderator.
  deletedById String?

  createdAt DateTime @default(now())

  channel     CommunityChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User                  @relation("CommunityMessages", fields: [authorId], references: [id], onDelete: Cascade)
  attachments CommunityAttachment[]
  mentions    CommunityMention[]
  reactions   CommunityReaction[]

  @@index([channelId, createdAt])
  @@index([authorId])
}

enum CommunityAttachmentKind {
  IMAGE
  PDF
  FILE
}

model CommunityAttachment {
  id          String                  @id @default(cuid())
  messageId   String
  kind        CommunityAttachmentKind
  /// Blob URL. Uploaded straight from the browser so a large screenshot never
  /// has to fit through a serverless request body.
  url         String
  fileName    String
  contentType String
  sizeBytes   Int

  message CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model CommunityMention {
  id        String @id @default(cuid())
  messageId String
  userId    String

  message CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User             @relation("CommunityMentions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

/// How far a student has read in a channel, for the unread dot.
model CommunityRead {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())

  user    User             @relation("CommunityReads", fields: [userId], references: [id], onDelete: Cascade)
  channel CommunityChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

/// An emoji reaction. One row per person per emoji per message, so the unique
/// constraint is what stops double-counting rather than application logic.
model CommunityReaction {
  id        String @id @default(cuid())
  messageId String
  userId    String
  /// The emoji itself, stored as the character. A short allowlist is enforced
  /// server-side, so this column never holds arbitrary user text.
  emoji     String

  createdAt DateTime @default(now())

  message CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User             @relation("CommunityReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}
