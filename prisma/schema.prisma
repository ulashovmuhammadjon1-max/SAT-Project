// SAT Platform database schema
// Postgres, accessed through Prisma Client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth v5 - Prisma adapter shape) + platform roles
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  ADMIN
  /// Reviews IELTS Writing and Speaking submissions. Strictly narrower than
  /// ADMIN: a reviewer sees only the submissions assigned to them, and nothing
  /// in the SAT admin surface.
  REVIEWER
}

/// Answers collected by the pre-signup onboarding wizard. Stored on the user
/// so the dashboard can personalise itself and the admin panel can report on
/// audience composition (country mix, grade mix, score targets).
enum OnboardingGoal {
  IMPROVE_SCORE
  FIRST_SAT
  RETAKING
  COLLEGE_ADMISSIONS
}

enum GradeLevel {
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
  GAP_YEAR
  COLLEGE
  OTHER
}

enum DailyGoalType {
  QUESTIONS
  MINUTES
}

/// An exam a student can prepare for. Stored as an array on the user, so
/// adding a third exam later is a new value rather than a new column.
enum ExamKind {
  SAT
  IELTS
}

/// What the dashboard is currently showing. BOTH is its own mode rather than
/// "no filter", because the combined dashboard is a different layout with a
/// balanced plan, not the two exams' dashboards stacked.
enum ExamMode {
  SAT
  IELTS
  BOTH
}

enum ExamPriority {
  SAT
  IELTS
  EQUAL
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // streak / gamification
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?

  // onboarding profile (all optional — accounts created before the wizard
  // existed, and admin accounts, simply have none of it)
  onboardingGoal     OnboardingGoal?
  currentScore       Int?
  targetScore        Int?
  dreamUniversities  String[]        @default([])
  countryCode        String?
  gradeLevel         GradeLevel?
  satDate            DateTime?
  strongestSection   String?
  weakestArea        String?
  studyMinutesPerDay Int?
  dailyGoalType      DailyGoalType?
  dailyGoalValue     Int?
  onboardedAt        DateTime?

  // --- Which exams this account is preparing for -------------------------
  //
  // Two distinct ideas, deliberately two columns. `preparationExams` is what
  // the student is working towards and decides what data exists; `activeExam`
  // is what they are looking at right now and decides what the dashboard
  // renders. A student preparing for both and currently viewing IELTS has
  // preparationExams = [SAT, IELTS] and activeExam = IELTS. Collapsing them
  // into one field would make "switch to IELTS for a minute" indistinguishable
  // from "stop preparing for the SAT".
  //
  // The default is SAT-only so every account that existed before this shipped
  // keeps exactly the dashboard it had, with no backfill and no onboarding
  // replay.
  preparationExams ExamKind[]   @default([SAT])
  activeExam       ExamMode     @default(SAT)
  /// Only meaningful in BOTH mode: which exam gets the larger share of the
  /// daily study time when the exam dates alone do not settle it.
  examPriority     ExamPriority @default(EQUAL)

  // --- Legal ------------------------------------------------------------
  /// When this account accepted the Terms and Privacy Policy, and which
  /// version. A checkbox nobody records proves nothing later, so the
  /// acceptance is stored rather than merely enforced in the form.
  /// Null on accounts created before the checkbox existed.
  termsAcceptedAt DateTime?
  termsVersion    String?

  // --- Scholarly Coins ---------------------------------------------------
  // Cached balance for fast reads. The CoinTransaction ledger is the record
  // of truth; this column is only ever written inside the same transaction
  // that writes a ledger row (see lib/coins.ts).
  coinBalance Int @default(0)

  // --- Referrals --------------------------------------------------------
  /// Stable public code used in ?ref= links. Assigned on first use rather
  /// than at signup so existing accounts backfill lazily.
  referralCode     String? @unique
  /// Who referred this account, if anyone. Denormalised from Referral for
  /// cheap "was this user referred" checks and self-referral guarding.
  referredById     String?
  referredBy       User?   @relation("ReferredAccounts", fields: [referredById], references: [id], onDelete: SetNull)
  referredAccounts User[]  @relation("ReferredAccounts")

  accounts Account[]
  sessions Session[]

  attempts         Attempt[]
  bookmarks        Bookmark[]
  questionAttempts QuestionAttempt[]
  bookings         Booking[]
  /// Bookings this user (an admin) approved, rejected or cancelled.
  bookingDecisions Booking[]         @relation("BookingDecider")

  /// Telegram identity, set once the student signs in through the Login Widget.
  /// Stored as a string rather than BigInt: ids can exceed 2^53 and this value
  /// is only ever passed straight back to Telegram, never used in arithmetic.
  telegramUserId         String?             @unique
  telegramUsername       String?
  telegramLinkedAt       DateTime?
  /// Last known channel membership and when it was established. Cached because
  /// the admin queue would otherwise call Telegram once per row on every render.
  telegramIsMember       Boolean             @default(false)
  telegramCheckedAt      DateTime?
  /// True when an admin set the flag by hand instead of it coming from
  /// getChatMember. Kept separate so the badge can say which it was — a value
  /// a human typed and a value Telegram confirmed are not the same evidence.
  telegramManualOverride Boolean             @default(false)
  vocabProgress          VocabProgress[]
  vocabSetProgress       VocabDeckProgress[]
  studyActivities        StudyActivity[]
  chatThreads            ChatThread[]
  auditLogs              AuditLog[]

  coinTransactions    CoinTransaction[] @relation("CoinLedgerOwner")
  coinAdjustmentsMade CoinTransaction[] @relation("CoinLedgerActor")
  referralsMade       Referral[]        @relation("ReferralsMade")
  referralReceived    Referral?         @relation("ReferralReceived")
  studyPlan           StudyPlan?
  platformSettings    PlatformSetting[] @relation("PlatformSettingUpdatedBy")

  communityMessages  CommunityMessage[]  @relation("CommunityMessages")
  communityMentions  CommunityMention[]  @relation("CommunityMentions")
  communityReads     CommunityRead[]     @relation("CommunityReads")
  communityReactions CommunityReaction[] @relation("CommunityReactions")

  uploadsCreated     PDFUpload[]       @relation("UploadedBy")
  uploadsReviewed    AIProcessingJob[] @relation("ReviewedBy")
  testsCreated       Test[]            @relation("TestCreatedBy")
  vocabWordsCreated  VocabWord[]       @relation("VocabCreatedBy")
  announcementsMade  Announcement[]    @relation("AnnouncementCreatedBy")
  adaptiveConfigsSet AdaptiveConfig[]  @relation("AdaptiveConfigUpdatedBy")

  ieltsProfile             IeltsStudentProfile?
  ieltsAttempts            IeltsAttempt[]
  ieltsWritingSubmissions  IeltsWritingSubmission[]
  ieltsSpeakingSubmissions IeltsSpeakingSubmission[]
  ieltsReviewerProfile     IeltsReviewerProfile?
  ieltsWritingReviews      IeltsWritingReview[]      @relation("IeltsWritingReviewer")
  ieltsSpeakingReviews     IeltsSpeakingReview[]     @relation("IeltsSpeakingReviewer")
  ieltsEssaysAuthored      IeltsEssay[]              @relation("IeltsEssayAuthor")

  researchProposals     ResearchProposal[]
  peerMentorApplication PeerMentorApplication?
  hostedSlots           MentorSlot[]           @relation("SlotHost")
  classMemberships      ClassMembership[]
  classesTaught         SchoolClass[]          @relation("ClassTeacher")

  @@index([role])
  @@index([countryCode])
  @@index([gradeLevel])
  @@index([onboardedAt])
  @@index([referredById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Curriculum taxonomy
// ---------------------------------------------------------------------------

enum Subject {
  READING_WRITING
  MATH
}

model Domain {
  id          String  @id @default(cuid())
  subject     Subject
  name        String
  code        String  @unique // e.g. "INI", "CAS", "EOI", "SEC", "ALG", "ADV", "PSDA", "GT"
  description String?
  order       Int     @default(0)

  skills    Skill[]
  questions Question[]

  @@index([subject])
}

model Skill {
  id          String  @id @default(cuid())
  domainId    String
  name        String
  code        String  @unique
  description String?
  order       Int     @default(0)

  domain    Domain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([domainId])
}

// ---------------------------------------------------------------------------
// Tests / adaptive modules
// ---------------------------------------------------------------------------

enum TestType {
  FULL_LENGTH
  PRACTICE_SET
  CUSTOM_QUIZ
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ModuleDifficulty {
  STANDARD // module 1 (or non-adaptive module)
  EASY // module 2, lower branch
  HARD // module 2, upper branch
}

model Test {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        TestType   @default(FULL_LENGTH)
  status      TestStatus @default(DRAFT)
  isAdaptive  Boolean    @default(true)

  adaptiveConfigId String?
  adaptiveConfig   AdaptiveConfig? @relation(fields: [adaptiveConfigId], references: [id])

  createdById String?
  createdBy   User?   @relation("TestCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules  Module[]
  attempts Attempt[]

  @@index([status, type])
}

model Module {
  id                   String           @id @default(cuid())
  testId               String
  subject              Subject
  order                Int // 1 or 2
  difficulty           ModuleDifficulty @default(STANDARD)
  title                String?
  timeLimitMinutes     Int              @default(32)
  // overrides the test-level adaptive config threshold when set
  adaptiveThresholdPct Int?

  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  passages  Passage[]
  questions Question[]

  moduleAttempts ModuleAttempt[]

  @@unique([testId, subject, order, difficulty])
  @@index([testId])
}

model Passage {
  id       String  @id @default(cuid())
  moduleId String?
  title    String?
  content  String  @db.Text // HTML/rich text
  imageUrl String?
  source   String?

  module    Module?    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([moduleId])
}

enum QuestionType {
  MULTIPLE_CHOICE
  FREE_RESPONSE // student-produced response (grid-in), math only
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id              String             @id @default(cuid())
  moduleId        String?
  passageId       String?
  domainId        String
  skillId         String
  type            QuestionType       @default(MULTIPLE_CHOICE)
  difficulty      QuestionDifficulty @default(MEDIUM)
  stem            String             @db.Text // HTML
  imageUrl        String?
  tableData       Json?
  order           Int                @default(0)
  points          Int                @default(1)
  correctAnswerFR String? // accepted answer(s) for free-response, JSON-encoded list as string
  isPublished     Boolean            @default(false)
  source          String? // e.g. "AI_EXTRACTED", "MANUAL"
  sourceUploadId  String?

  module  Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  passage Passage? @relation(fields: [passageId], references: [id], onDelete: SetNull)
  domain  Domain   @relation(fields: [domainId], references: [id])
  skill   Skill    @relation(fields: [skillId], references: [id])

  choices          AnswerChoice[]
  explanation      Explanation?
  responses        Response[]
  bookmarks        Bookmark[]
  questionAttempts QuestionAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@index([domainId, skillId])
  @@index([difficulty])
}

model AnswerChoice {
  id         String  @id @default(cuid())
  questionId String
  label      String // "A" | "B" | "C" | "D"
  content    String  @db.Text
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question  Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses Response[]

  @@index([questionId])
}

enum ExplanationSource {
  MANUAL
  AI_GENERATED
}

model Explanation {
  id              String            @id @default(cuid())
  questionId      String            @unique
  content         String            @db.Text
  whyCorrect      String?           @db.Text
  whyWrongJson    Json? // { [choiceId]: string }
  commonMistakes  String?           @db.Text
  tips            String?           @db.Text
  relatedConcepts String?           @db.Text
  source          ExplanationSource @default(MANUAL)
  generatedAt     DateTime?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Attempts / responses
// ---------------------------------------------------------------------------

enum AttemptStatus {
  IN_PROGRESS
  PAUSED
  SUBMITTED
  ABANDONED
}

model Attempt {
  id     String        @id @default(cuid())
  userId String
  testId String
  status AttemptStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  pausedAt    DateTime?

  currentModuleId String?

  module1ScorePct      Float?
  assignedModule2Level ModuleDifficulty?

  totalScaledScore Int?
  mathScaledScore  Int?
  rwScaledScore    Int?

  duplicateOfAttemptId String?
  duplicateOf          Attempt?  @relation("AttemptDuplicate", fields: [duplicateOfAttemptId], references: [id])
  duplicates           Attempt[] @relation("AttemptDuplicate")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  test Test @relation(fields: [testId], references: [id])

  moduleAttempts ModuleAttempt[]
  responses      Response[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([testId])
}

model ModuleAttempt {
  id        String @id @default(cuid())
  attemptId String
  moduleId  String

  startedAt        DateTime  @default(now())
  submittedAt      DateTime?
  timeSpentSeconds Int       @default(0)
  correctCount     Int       @default(0)
  totalCount       Int       @default(0)
  scaledScore      Int?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id])

  @@unique([attemptId, moduleId])
}

model Response {
  id              String @id @default(cuid())
  attemptId       String
  moduleAttemptId String
  questionId      String

  selectedChoiceId    String?
  freeResponseAnswer  String?
  isCorrect           Boolean?
  timeSpentSeconds    Int       @default(0)
  changedAnswerCount  Int       @default(0)
  flagged             Boolean   @default(false)
  eliminatedChoiceIds Json? // string[]
  order               Int       @default(0)
  answeredAt          DateTime?

  attempt        Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question      @relation(fields: [questionId], references: [id])
  selectedChoice AnswerChoice? @relation(fields: [selectedChoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([moduleAttemptId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  note       String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

/// A single answer submitted in the Question Bank (untimed, outside a test).
///
/// Deliberately separate from `Response`, which is scoped to a test `Attempt`
/// and `ModuleAttempt` and must keep its exam semantics. A student may answer
/// the same question many times here, so rows accumulate — "attempted" means
/// *distinct* questionIds, and Question Bank progress reads both this table
/// and `Response` so work done inside a mock still counts.
model QuestionAttempt {
  id                 String   @id @default(cuid())
  userId             String
  questionId         String
  selectedChoiceId   String?
  freeResponseAnswer String?
  isCorrect          Boolean
  timeSpentSeconds   Int      @default(0)
  createdAt          DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, questionId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Free 1:1 mentorship booking
// ---------------------------------------------------------------------------

enum BookingStatus {
  /// Booked by the student, seat and coins held, waiting on an admin decision.
  PENDING
  /// Approved. This is what "confirmed" means to a student.
  UPCOMING
  COMPLETED
  /// Withdrawn after it existed — by the student, or by an admin after approval.
  CANCELLED
  /// Turned down by an admin before it was ever confirmed.
  REJECTED
}

/// What kind of session a slot/booking is.
///
/// Scholarly will run financial-literacy classes, expert lectures and weekly
/// test-analysis sessions alongside 1-on-1 guidance, so the booking system is
/// typed from the start rather than hard-coded to SAT tutoring.
enum SessionType {
  ONE_ON_ONE_SAT
  TEST_ANALYSIS
  FINANCIAL_LITERACY
  LECTURE
  WORKSHOP
}

/// A bookable slot published by a mentor/admin.
///
/// Stored as an absolute UTC instant; the student UI renders it in their own
/// timezone. `isBlocked` lets an admin retire a slot without deleting history.
model MentorSlot {
  id              String   @id @default(cuid())
  startsAt        DateTime
  durationMinutes Int      @default(30)
  isBlocked       Boolean  @default(false)
  note            String?
  createdAt       DateTime @default(now())

  sessionType SessionType @default(ONE_ON_ONE_SAT)
  /// Seats. 1 keeps the existing 1-on-1 semantics; a lecture can open many.
  capacity    Int         @default(1)
  /// Shown on the events page. Null for plain 1-on-1 slots, which need no name.
  title       String?
  description String?     @db.Text

  /// Who hosts this slot. Null means the founder/admin — which is every slot
  /// that existed before the peer-mentor programme, with no backfill needed.
  hostId String?
  host   User?   @relation("SlotHost", fields: [hostId], references: [id], onDelete: SetNull)

  bookings Booking[]

  @@unique([startsAt])
  @@index([startsAt])
  @@index([hostId])
}

model Booking {
  id     String        @id @default(cuid())
  userId String
  slotId String
  status BookingStatus @default(UPCOMING)

  // Snapshot of what the student told us at booking time. Copied rather than
  // read live off User so the mentor sees what was actually submitted.
  name              String
  email             String
  currentScore      Int?
  targetScore       Int?
  satDate           DateTime?
  studyHoursPerWeek Int?
  weakestArea       String?
  notes             String?   @db.Text
  timezone          String? // IANA zone captured from the browser, for display

  sessionType SessionType @default(ONE_ON_ONE_SAT)

  /// Coins actually charged, snapshotted at booking time. Stored rather than
  /// recomputed because the price ladder depends on how many bookings the
  /// student had made *then*, and because a refund must return exactly what
  /// was taken even if the ladder or the settings have since changed.
  coinCost Int @default(0)

  /// When the student attested to the community follow/join requirements.
  /// An attestation, not a verified fact — see lib/community.ts.
  requirementsAckAt DateTime?

  /// Meeting join URL from whichever provider created it, and the provider's
  /// own id so a booking can later be reconciled or cancelled upstream.
  meetingUrl        String?
  meetingProvider   String?
  meetingExternalId String?

  /// What an admin typed when approving, rejecting or cancelling. Shown to the
  /// student in the decision email and on My Sessions, so it is student-facing
  /// prose, not an internal note.
  statusReason String?   @db.Text
  /// When an admin last approved/rejected/cancelled, and who did it. Kept even
  /// if that admin is later deleted, hence SetNull rather than Cascade.
  decidedAt    DateTime?
  decidedById  String?

  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?      @relation("BookingDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  slot      MentorSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  coinTransactions CoinTransaction[]

  /// A student can hold at most one booking per slot. This replaces the old
  /// `slotId @unique`, which capped every slot at one attendee and made group
  /// events impossible. Capacity is now enforced inside the booking
  /// transaction under a row lock on the slot — see createBooking.
  @@unique([slotId, userId])
  @@index([userId, status])
  @@index([status])
  @@index([slotId, status])
  @@index([sessionType, status])
}

// ---------------------------------------------------------------------------
// Vocabulary
// ---------------------------------------------------------------------------

enum VocabDifficulty {
  EASY
  MEDIUM
  HARD
}

enum VocabStatus {
  NEW
  LEARNING
  MASTERED
}

enum VocabVisibility {
  PUBLIC // admin-curated, visible to every student
  PRIVATE // added by a student for their own personal study list
}

// A named source book/package (e.g. "College Panda 400 Words", "Ivy Global
// 500 Words"). Each collection contains its own gated sequence of sets.
model VocabCollection {
  id          String   @id @default(cuid())
  name        String
  description String?
  order       Int?
  createdAt   DateTime @default(now())

  decks VocabDeck[]

  @@index([order])
}

model VocabDeck {
  id           String   @id @default(cuid())
  name         String
  description  String?
  order        Int? // sequence position within its collection (e.g. "Set 1".."Set 16"); null = not part of a gated sequence
  passageTitle String?
  passage      String?  @db.Text
  createdAt    DateTime @default(now())

  collectionId String?
  collection   VocabCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  words         VocabDeckWord[]
  quizQuestions VocabSetQuizQuestion[]
  progress      VocabDeckProgress[]

  @@unique([collectionId, order])
  @@index([order])
}

model VocabSetQuizQuestion {
  id      String @id @default(cuid())
  deckId  String
  order   Int
  stem    String @db.Text
  choiceA String @db.Text
  choiceB String @db.Text
  choiceC String @db.Text
  choiceD String @db.Text
  correct String // "A" | "B" | "C" | "D"

  deck VocabDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([deckId, order])
}

// Per-user completion state for a gated VocabDeck ("set"). A set counts as
// passed once its quiz is cleared at or above the required score, which is
// what unlocks the next set in the sequence.
model VocabDeckProgress {
  id          String    @id @default(cuid())
  userId      String
  deckId      String
  bestScore   Int       @default(0)
  attempts    Int       @default(0)
  passed      Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck VocabDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([userId, deckId])
}

model VocabWord {
  id              String          @id @default(cuid())
  term            String
  partOfSpeech    String?
  definition      String          @db.Text
  exampleSentence String?         @db.Text
  difficulty      VocabDifficulty @default(MEDIUM)
  synonyms        Json? // string[]
  antonyms        Json? // string[]
  audioUrl        String?
  imageUrl        String?
  visibility      VocabVisibility @default(PUBLIC)

  createdById    String?
  createdBy      User?   @relation("VocabCreatedBy", fields: [createdById], references: [id])
  sourceUploadId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decks    VocabDeckWord[]
  progress VocabProgress[]

  @@index([difficulty])
  @@index([term])
  @@index([visibility])
}

model VocabDeckWord {
  deckId String
  wordId String
  order  Int    @default(0)

  deck VocabDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([deckId, wordId])
}

// Spaced repetition progress per user/word (SM-2 style)
model VocabProgress {
  id     String @id @default(cuid())
  userId String
  wordId String

  status         VocabStatus @default(NEW)
  easeFactor     Float       @default(2.5)
  intervalDays   Int         @default(0)
  repetitions    Int         @default(0)
  correctStreak  Int         @default(0)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  isBookmarked   Boolean     @default(false)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, nextReviewAt])
}

// ---------------------------------------------------------------------------
// PDF ingestion / AI processing pipeline
// ---------------------------------------------------------------------------

enum UploadCategory {
  FULL_TEST
  QUESTION_BANK
  VOCABULARY
}

enum UploadStatus {
  PENDING
  PROCESSING
  NEEDS_REVIEW
  COMPLETED
  FAILED
}

model PDFUpload {
  id       String         @id @default(cuid())
  fileName String
  fileUrl  String
  fileSize Int
  category UploadCategory
  status   UploadStatus   @default(PENDING)

  uploadedById String?
  uploadedBy   User?   @relation("UploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs AIProcessingJob[]

  @@index([status, category])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model AIProcessingJob {
  id       String    @id @default(cuid())
  uploadId String
  status   JobStatus @default(QUEUED)

  startedAt       DateTime?
  completedAt     DateTime?
  confidenceScore Float? // 0-1, overall extraction confidence
  extractedData   Json? // structured extraction result awaiting review
  errorMessage    String?   @db.Text
  logs            Json? // step-by-step trace for the admin queue view

  reviewedById String?
  reviewedBy   User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  publishedAt  DateTime?

  upload PDFUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([status])
  @@index([uploadId])
}

// ---------------------------------------------------------------------------
// Adaptive engine configuration (admin-editable)
// ---------------------------------------------------------------------------

model AdaptiveConfig {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(false)

  // % correct on module 1 at/above which a student routes to the HARD module 2
  rwThresholdPct   Int @default(70)
  mathThresholdPct Int @default(70)

  updatedById String?
  updatedBy   User?    @relation("AdaptiveConfigUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  tests Test[]
}

// ---------------------------------------------------------------------------
// Platform admin: feature flags, announcements, activity, audit, AI chat
// ---------------------------------------------------------------------------

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  isEnabled   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

enum AnnouncementAudience {
  ALL
  STUDENT
  ADMIN
}

model Announcement {
  id        String               @id @default(cuid())
  title     String
  body      String               @db.Text
  audience  AnnouncementAudience @default(ALL)
  isActive  Boolean              @default(true)
  expiresAt DateTime?

  createdById String?
  createdBy   User?   @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}

// per-day activity used for streaks + heatmaps
model StudyActivity {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime @db.Date
  questionsAnswered Int      @default(0)
  minutesStudied    Int      @default(0)
  vocabReviewed     Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
}

// Future feature: AI tutor / review-mode chat assistant
enum ChatRole {
  USER
  ASSISTANT
}

model ChatThread {
  id         String   @id @default(cuid())
  userId     String
  questionId String?
  attemptId  String?
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Scholarly Coins — engagement currency
//
// Coins are internal, not money, and must never be mutated from the client.
// `User.coinBalance` is the fast read used by the UI; `CoinTransaction` is the
// ledger of record and every balance change writes one. `balanceAfter` is
// stamped on each row so the ledger can be replayed and reconciled against the
// cached balance without recomputing a running sum in the client.
// ---------------------------------------------------------------------------

enum CoinTxnType {
  SIGNUP_BONUS
  REFERRAL_REWARD
  BOOKING_SPEND
  BOOKING_REFUND
  ADMIN_ADJUSTMENT
  PROMOTION
}

model CoinTransaction {
  id           String      @id @default(cuid())
  userId       String
  /// Signed: +15 for a referral reward, -10 for a booking. Never 0.
  amount       Int
  type         CoinTxnType
  /// The user's balance immediately after this row was written, inside the
  /// same transaction that wrote it.
  balanceAfter Int
  description  String

  /// Set for BOOKING_SPEND / BOOKING_REFUND. SetNull rather than Cascade: the
  /// ledger must survive the deletion of what it refers to.
  bookingId  String?
  referralId String?
  /// The admin who made an ADMIN_ADJUSTMENT.
  actorId    String?

  /// Guards against a retried action double-crediting. Callers derive a stable
  /// key from the event ("signup:<userId>", "referral:<referralId>"), so a
  /// second attempt violates the unique index instead of paying twice.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  user     User      @relation("CoinLedgerOwner", fields: [userId], references: [id], onDelete: Cascade)
  actor    User?     @relation("CoinLedgerActor", fields: [actorId], references: [id], onDelete: SetNull)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  referral Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type])
}

enum ReferralStatus {
  /// Code was attributed at signup; reward not yet paid.
  PENDING
  /// Reward paid.
  REWARDED
  /// Rejected by an abuse rule, or reversed by an admin.
  VOID
}

/// One row per referred account. `referredUserId` is unique, so an account can
/// only ever be counted once no matter how many times a code is replayed.
model Referral {
  id             String         @id @default(cuid())
  referrerId     String
  referredUserId String         @unique
  code           String
  status         ReferralStatus @default(PENDING)
  rewardedAt     DateTime?
  /// Why an abuse rule voided this, for admin review.
  voidReason     String?
  createdAt      DateTime       @default(now())

  referrer     User @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferralReceived", fields: [referredUserId], references: [id], onDelete: Cascade)

  coinTransactions CoinTransaction[]

  @@index([referrerId, status])
  @@index([code])
}

/// Admin-tunable platform values (booking base cost and increment, referral
/// reward, signup bonus, community handles, refund policy).
///
/// Key/value rather than columns so a new knob does not need a migration, and
/// so `lib/settings.ts` can hold the defaults and the parsing in one place.
model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?
  updatedBy   User?    @relation("PlatformSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Personalized study plan
// ---------------------------------------------------------------------------

/// A cached snapshot of the generated plan.
///
/// The plan is DERIVED from the student's profile plus their live question
/// performance, so it is recomputed rather than edited. This table exists so
/// the dashboard does not re-run the aggregation on every render, and so
/// milestone completion has somewhere to live. `evidenceCount` records how
/// many graded answers the snapshot was built from — when that number moves,
/// the plan is stale and gets rebuilt.
model StudyPlan {
  id     String @id @default(cuid())
  userId String @unique

  /// The rendered plan (weeks, focus areas, milestones). Shape owned by
  /// `lib/plan/types.ts`.
  data Json

  targetScore   Int?
  currentScore  Int?
  testDate      DateTime?
  /// Graded answers the snapshot was computed from.
  evidenceCount Int       @default(0)
  generatedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Community chat
//
// Channel-based discussion between students. Messages are plain text, stored
// unrendered: the client escapes and linkifies at display time, so a message
// can never inject markup into another student's page. Mentions are resolved
// server-side into rows rather than being parsed out of the body on every
// read, which keeps "who was tagged" answerable without re-scanning text.
//
// Deletion is soft. A hard delete would tear replies out of their context and
// leave dangling "replying to a deleted message" threads with no way to show
// that something was removed; `deletedAt` keeps the shape of the conversation
// while hiding the content.
// ---------------------------------------------------------------------------

model CommunityChannel {
  id          String  @id @default(cuid())
  /// URL segment: /community/<slug>
  slug        String  @unique
  name        String
  description String?
  /// Display order in the channel list.
  order       Int     @default(0)
  /// Announcements: admins post, students read.
  isReadOnly  Boolean @default(false)
  isArchived  Boolean @default(false)

  createdAt DateTime @default(now())

  messages CommunityMessage[]
  reads    CommunityRead[]

  @@index([isArchived, order])
}

model CommunityMessage {
  id        String @id @default(cuid())
  channelId String
  authorId  String

  /// Raw text as typed. Never HTML — see the note above.
  body String @db.Text

  /// The message this one replies to. SetNull rather than Cascade so deleting
  /// a parent does not silently erase every reply under it.
  replyToId String?
  replyTo   CommunityMessage?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   CommunityMessage[] @relation("MessageReply")

  editedAt    DateTime?
  deletedAt   DateTime?
  /// Who removed it — the author themselves, or a moderator.
  deletedById String?

  createdAt DateTime @default(now())

  channel     CommunityChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User                  @relation("CommunityMessages", fields: [authorId], references: [id], onDelete: Cascade)
  attachments CommunityAttachment[]
  mentions    CommunityMention[]
  reactions   CommunityReaction[]

  @@index([channelId, createdAt])
  @@index([authorId])
}

enum CommunityAttachmentKind {
  IMAGE
  PDF
  FILE
}

model CommunityAttachment {
  id          String                  @id @default(cuid())
  messageId   String
  kind        CommunityAttachmentKind
  /// Blob URL. Uploaded straight from the browser so a large screenshot never
  /// has to fit through a serverless request body.
  url         String
  fileName    String
  contentType String
  sizeBytes   Int

  message CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model CommunityMention {
  id        String @id @default(cuid())
  messageId String
  userId    String

  message CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User             @relation("CommunityMentions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

/// How far a student has read in a channel, for the unread dot.
model CommunityRead {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())

  user    User             @relation("CommunityReads", fields: [userId], references: [id], onDelete: Cascade)
  channel CommunityChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

/// An emoji reaction. One row per person per emoji per message, so the unique
/// constraint is what stops double-counting rather than application logic.
model CommunityReaction {
  id        String @id @default(cuid())
  messageId String
  userId    String
  /// The emoji itself, stored as the character. A short allowlist is enforced
  /// server-side, so this column never holds arbitrary user text.
  emoji     String

  createdAt DateTime @default(now())

  message CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User             @relation("CommunityReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ---------------------------------------------------------------------------
// Partners
// ---------------------------------------------------------------------------

/// A partner whose logo appears on the landing page and links out to them.
///
/// Kept in the database rather than a config file so a partnership can be added
/// or pulled without a deploy — the practical case being that a partner goes
/// quiet and their logo has to come down the same day.
model Partner {
  id          String   @id @default(cuid())
  name        String
  /// Served through /api/images/... for uploads, or any absolute https URL.
  logoUrl     String
  /// Where clicking the logo goes. Validated as http(s) on write, because this
  /// value ends up in an href and a javascript: URL there would be an XSS.
  href        String
  /// One line under the name. Optional — most rows are just a logo.
  blurb       String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, order])
}

// ---------------------------------------------------------------------------
// IELTS Academic
//
// A parallel content and attempt tree rather than an extension of the SAT one.
// The two exams disagree on nearly everything that matters structurally: a
// module has a fixed 22/27 questions where an IELTS part does not, the SAT is
// adaptive where IELTS is not, SAT questions are all machine-marked where
// IELTS Writing and Speaking are human-marked, and an IELTS answer is often a
// typed phrase judged against a list of accepted spellings rather than a
// choice id. Bending `Question` to cover both would put a dozen nullable
// columns on the hottest table in the app.
//
// Nothing here touches an existing model except `Role`, which gains REVIEWER.
// ---------------------------------------------------------------------------

/// Academic only for v1. GENERAL_TRAINING exists so the column never has to be
/// migrated later; nothing reads it yet.
enum IeltsModule {
  ACADEMIC
  GENERAL_TRAINING
}

enum IeltsSkill {
  LISTENING
  READING
  WRITING
  SPEAKING
}

/// How strictly the engine behaves. REALISTIC is the exam: audio plays once,
/// the clock cannot be paused, nothing is revealed until submission. PRACTICE
/// relaxes replay and reveals answers as you go.
enum IeltsAttemptMode {
  REALISTIC
  PRACTICE
}

enum IeltsAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
  /// Objective sections are marked but Writing/Speaking await a human.
  AWAITING_REVIEW
  COMPLETE
}

/// The documented IELTS Academic question formats. The engine renders one
/// component per value, so adding a format means adding a component, not a
/// migration.
enum IeltsQuestionType {
  MULTIPLE_CHOICE_SINGLE
  MULTIPLE_CHOICE_MULTI
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  MATCHING_INFORMATION
  MATCHING_HEADINGS
  MATCHING_FEATURES
  MATCHING_SENTENCE_ENDINGS
  MATCHING_GENERAL
  PLAN_MAP_DIAGRAM_LABEL
  FORM_COMPLETION
  NOTE_COMPLETION
  TABLE_COMPLETION
  FLOWCHART_COMPLETION
  SUMMARY_COMPLETION
  SENTENCE_COMPLETION
  SHORT_ANSWER
  DIAGRAM_LABEL_COMPLETION
}

enum IeltsTestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A publishable IELTS paper. A "full test" carries all four skills; a
/// single-skill paper carries one, which is what the Practice cards start.
model IeltsTest {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  module      IeltsModule     @default(ACADEMIC)
  status      IeltsTestStatus @default(DRAFT)
  description String?
  /// 1 easiest … 5 hardest. Shown on the selection card.
  difficulty  Int             @default(3)

  sections IeltsSection[]
  attempts IeltsAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, module])
}

/// One skill within a paper. Listening and Reading carry parts; Writing carries
/// two tasks; Speaking carries three parts.
model IeltsSection {
  id              String     @id @default(cuid())
  testId          String
  skill           IeltsSkill
  /// Ordering among sections of the same paper.
  order           Int        @default(0)
  /// Whole-section clock. Reading is 60, Writing 60. Listening is paced per
  /// part instead, so this is the fallback ceiling rather than the rule.
  durationMinutes Int
  instructions    String?

  test  IeltsTest   @relation(fields: [testId], references: [id], onDelete: Cascade)
  parts IeltsPart[]

  attempts IeltsSectionAttempt[]

  @@unique([testId, skill])
  @@index([testId])
}

/// A Listening part, a Reading passage, a Writing task, or a Speaking part.
model IeltsPart {
  id           String  @id @default(cuid())
  sectionId    String
  /// 1-4 for Listening, 1-3 for Reading and Speaking, 1-2 for Writing.
  partNumber   Int
  title        String?
  instructions String?

  /// Reading passage body, as rich HTML. Null for other skills.
  passageHtml String?
  /// Writing task prompt, as rich HTML. Null for other skills.
  promptHtml  String?
  /// The Task 1 chart/diagram, or a Listening/Reading figure.
  imageUrl    String?
  imageAlt    String?

  /// Listening audio for this part. Served through a signed route, never as a
  /// public URL, so a student cannot fetch it ahead of the test.
  audioUrl      String?
  audioDuration Int?
  /// Admin- and reviewer-only. Never sent to a student's browser.
  transcript    String?

  /// Speaking timings, in seconds.
  prepSeconds  Int?
  speakSeconds Int?

  /// Writing minimum word count: 150 for Task 1, 250 for Task 2.
  minWords Int?

  section   IeltsSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  groups    IeltsQuestionGroup[]
  questions IeltsQuestion[]

  @@unique([sectionId, partNumber])
  @@index([sectionId])
}

/// A run of questions sharing one instruction line and one answer format —
/// "Questions 7-10: Complete the notes below. NO MORE THAN TWO WORDS."
///
/// IELTS instructions attach to a block, not to a single question, and the
/// word limit is printed once above the block. Modelling that as a group keeps
/// the limit in one place instead of copied onto every row, where it would
/// eventually disagree with itself.
model IeltsQuestionGroup {
  id           String            @id @default(cuid())
  partId       String
  order        Int               @default(0)
  type         IeltsQuestionType
  /// "Complete the notes below." — printed above the block.
  instructions String
  /// "NO MORE THAN TWO WORDS AND/OR A NUMBER", shown to the student and
  /// enforced by the answer validator.
  wordLimit    String?
  maxWords     Int?
  maxNumbers   Int?
  /// Shared body for the block: a summary with gaps, a table, a flow chart.
  /// Gaps are marked `{{7}}` with the question number.
  bodyHtml     String?
  /// Options shared across the block — the heading list for Matching
  /// Headings, the feature list for Matching Features. `[{key, text}]`.
  optionsJson  Json?
  imageUrl     String?
  imageAlt     String?

  part      IeltsPart       @relation(fields: [partId], references: [id], onDelete: Cascade)
  questions IeltsQuestion[]

  @@index([partId, order])
}

/// One numbered question. `number` is the 1-40 number the student sees, unique
/// within its section, which is what the navigation bar and the answer sheet
/// both key on.
model IeltsQuestion {
  id      String            @id @default(cuid())
  partId  String
  groupId String?
  /// 1-40 within the section.
  number  Int
  type    IeltsQuestionType

  /// The question text. Empty for a gap inside a group body, where the prompt
  /// IS the surrounding text.
  promptHtml  String?
  /// Per-question choices for multiple choice: `[{key, text}]`.
  optionsJson Json?

  /// The canonical answer. A choice key for multiple choice, the expected text
  /// for a completion.
  correctAnswer    String
  /// Every other answer marked right: alternative spellings, contractions,
  /// with/without an article. `string[]`.
  acceptedAnswers  Json?
  /// Multi-answer questions expect a set; order does not matter. `string[]`.
  correctAnswerSet Json?
  /// Off by default: IELTS accepts either case for a typed answer.
  caseSensitive    Boolean @default(false)

  explanation    String?
  /// Where in the passage or audio the answer comes from. Shown in review.
  answerLocation String?

  /// Free-form analytics tags: topic, sub-skill, anything worth slicing on.
  metadata Json?

  part    IeltsPart           @relation(fields: [partId], references: [id], onDelete: Cascade)
  group   IeltsQuestionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  answers IeltsAnswer[]

  @@index([partId, number])
  @@index([groupId])
}

/// One sitting of one paper. A full test links all four skills under a single
/// attempt so the overall band can be computed once every part is in.
model IeltsAttempt {
  id     String             @id @default(cuid())
  userId String
  testId String
  mode   IeltsAttemptMode   @default(REALISTIC)
  status IeltsAttemptStatus @default(IN_PROGRESS)
  /// Which skills this sitting covers — a full test is all four, a Reading
  /// practice is one. `IeltsSkill[]`.
  skills Json

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  listeningRaw  Int?
  listeningBand Float?
  readingRaw    Int?
  readingBand   Float?
  writingBand   Float?
  speakingBand  Float?
  /// The four components combined under IELTS rounding.
  overallBand   Float?

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  test               IeltsTest                @relation(fields: [testId], references: [id])
  sections           IeltsSectionAttempt[]
  answers            IeltsAnswer[]
  writingSubmissions IeltsWritingSubmission[]
  speakingSubmission IeltsSpeakingSubmission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([testId])
}

model IeltsSectionAttempt {
  id        String @id @default(cuid())
  attemptId String
  sectionId String

  startedAt        DateTime  @default(now())
  submittedAt      DateTime?
  /// Server-side deadline. The client clock is a display; this is what
  /// actually decides whether an answer still counts, so a reloaded page or a
  /// tampered timer cannot buy extra minutes.
  expiresAt        DateTime?
  timeSpentSeconds Int       @default(0)

  /// Listening only: which part is playing, and whether its audio has run.
  currentPart Int   @default(1)
  /// Part numbers whose audio has already played. Once a part is in here its
  /// audio will not be served again in REALISTIC mode. `number[]`.
  playedParts Json?

  rawScore   Int?
  totalCount Int?
  band       Float?

  attempt IeltsAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section IeltsSection @relation(fields: [sectionId], references: [id])

  @@unique([attemptId, sectionId])
}

model IeltsAnswer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String

  /// What the student typed or selected. A choice key, a typed phrase, or a
  /// JSON array for a multi-answer question.
  value      String?
  isCorrect  Boolean?
  flagged    Boolean   @default(false)
  answeredAt DateTime?

  attempt  IeltsAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question IeltsQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([questionId])
}

/// Highlights and notes a student makes on a Reading passage. Kept per attempt
/// so they vanish with the sitting rather than leaking into the next one.
model IeltsPassageMark {
  id          String   @id @default(cuid())
  attemptId   String
  partId      String
  /// Character offsets into the passage's plain text.
  startOffset Int
  endOffset   Int
  quote       String
  note        String?
  createdAt   DateTime @default(now())

  @@index([attemptId, partId])
}

enum IeltsReviewStatus {
  PENDING
  ASSIGNED
  IN_REVIEW
  COMPLETE
  RETURNED
}

/// One Writing task response awaiting or holding a human review.
model IeltsWritingSubmission {
  id        String @id @default(cuid())
  attemptId String
  partId    String
  userId    String

  responseText String
  wordCount    Int
  submittedAt  DateTime @default(now())

  status IeltsReviewStatus @default(PENDING)

  attempt IeltsAttempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  review  IeltsWritingReview?

  @@unique([attemptId, partId])
  @@index([userId, status])
  @@index([status])
}

model IeltsWritingReview {
  id           String @id @default(cuid())
  submissionId String @unique
  reviewerId   String

  /// Task Achievement (Task 1) / Task Response (Task 2).
  taskBand      Float
  coherenceBand Float
  lexicalBand   Float
  grammarBand   Float
  /// The four criteria averaged and rounded to the nearest half band.
  overallBand   Float

  overallFeedback   String?
  didWell           String?
  toImprove         String?
  vocabularyNotes   String?
  grammarNotes      String?
  coherenceNotes    String?
  taskResponseNotes String?
  nextSteps         String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  submission  IeltsWritingSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer    User                     @relation("IeltsWritingReviewer", fields: [reviewerId], references: [id])
  annotations IeltsWritingAnnotation[]

  @@index([reviewerId])
}

/// An inline comment anchored to a span of the student's own text.
model IeltsWritingAnnotation {
  id          String   @id @default(cuid())
  reviewId    String
  startOffset Int
  endOffset   Int
  quote       String
  comment     String
  /// praise | issue | suggestion — drives the colour of the underline.
  kind        String   @default("issue")
  createdAt   DateTime @default(now())

  review IeltsWritingReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

/// The whole three-part Speaking sitting, submitted as one package.
model IeltsSpeakingSubmission {
  id        String @id @default(cuid())
  attemptId String @unique
  userId    String

  submittedAt DateTime          @default(now())
  status      IeltsReviewStatus @default(PENDING)

  attempt    IeltsAttempt             @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordings IeltsSpeakingRecording[]
  review     IeltsSpeakingReview?

  @@index([userId, status])
  @@index([status])
}

model IeltsSpeakingRecording {
  id            String @id @default(cuid())
  submissionId  String
  partId        String
  /// Which prompt inside the part this answers. Part 2 has exactly one.
  questionIndex Int    @default(0)
  promptText    String

  /// Served through a signed route, never a public URL.
  audioUrl        String
  durationSeconds Int
  createdAt       DateTime @default(now())

  submission IeltsSpeakingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  comments   IeltsSpeakingComment[]

  @@index([submissionId])
}

model IeltsSpeakingReview {
  id           String @id @default(cuid())
  submissionId String @unique
  reviewerId   String

  fluencyBand       Float
  lexicalBand       Float
  grammarBand       Float
  pronunciationBand Float
  overallBand       Float

  overallFeedback    String?
  fluencyNotes       String?
  vocabularyNotes    String?
  grammarNotes       String?
  pronunciationNotes String?
  strongPoints       String?
  weaknesses         String?
  howToImprove       String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  submission IeltsSpeakingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User                    @relation("IeltsSpeakingReviewer", fields: [reviewerId], references: [id])

  @@index([reviewerId])
}

/// A reviewer comment pinned to a moment in a recording.
model IeltsSpeakingComment {
  id          String   @id @default(cuid())
  recordingId String
  atSeconds   Int
  comment     String
  createdAt   DateTime @default(now())

  recording IeltsSpeakingRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId])
}

/// A verified reviewer. Nobody self-certifies: an admin sets `approved`, and
/// the review queue only ever offers work to approved reviewers.
model IeltsReviewerProfile {
  id     String @id @default(cuid())
  userId String @unique

  canReviewWriting  Boolean @default(false)
  canReviewSpeaking Boolean @default(false)
  /// The band the reviewer themselves achieved, shown to students as
  /// "Reviewed by a Band 8 IELTS writer". Never described as examiner status.
  writingBand       Float?
  speakingBand      Float?

  approved     Boolean   @default(false)
  approvedById String?
  approvedAt   DateTime?
  bio          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approved])
}

/// Raw-score to band, configurable per paper because the real conversion
/// varies by form. A single hardcoded table would quietly misreport every
/// paper it was not built from.
model IeltsScoreConversion {
  id       String      @id @default(cuid())
  /// Null means "the default table for this skill", used when a paper has no
  /// table of its own.
  testId   String?
  module   IeltsModule @default(ACADEMIC)
  skill    IeltsSkill
  rawScore Int
  band     Float

  @@unique([testId, module, skill, rawScore])
  @@index([module, skill])
}

/// The IELTS half of a student's goals, mirroring the SAT fields that live
/// directly on `User`.
///
/// A separate table rather than more nullable columns on `User`: the SAT
/// fields are there for historical reasons, and repeating that pattern would
/// leave one row carrying two exams' worth of optional state. It also means a
/// student who never touches IELTS has no IELTS row at all, which is the
/// cleanest possible answer to "is this student preparing for IELTS".
model IeltsStudentProfile {
  id     String @id @default(cuid())
  userId String @unique

  /// 4.0 to 9.0 in half steps.
  targetBand Float?
  examDate   DateTime?
  /// university | work | immigration | other
  reason     String?

  /// Self-reported or diagnosed starting point, per skill.
  currentListening Float?
  currentReading   Float?
  currentWriting   Float?
  currentSpeaking  Float?
  currentOverall   Float?
  /// Where the starting point came from: self | previous | diagnostic.
  levelSource      String?

  studyMinutesPerDay Int?
  onboardedAt        DateTime?

  /// WRITING | SPEAKING — which of the two skills the student said worries
  /// them more, so the plan can lead with it. Added after the table shipped:
  /// every other query on this model uses an explicit select that omits it,
  /// and the one read that needs it is guarded, so a database without the
  /// column degrades to "no preference" instead of throwing P2022.
  focusSkill String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// IELTS Writing Task 2 — Band 8+ model-essay library ("Essay Analyzer")
//
// Admin-curated teaching material, not student submissions. An admin writes or
// pastes a Band 8+ Task 2 essay, the model deconstructs it into annotations and
// reusable ideas, the admin corrects that, and only then does it reach a
// student. Nothing here is ever written by a student — the student-facing
// submission path is IeltsWritingSubmission and is deliberately separate.
// ---------------------------------------------------------------------------

/// Where an essay is in the curation pipeline.
///
/// NEEDS_REVIEW is the important one: the model has produced annotations and a
/// human has not yet checked them. An essay may never reach a student from that
/// state, which is what keeps the AI an assistant rather than the author.
enum IeltsEssayStatus {
  DRAFT
  ANALYZING
  NEEDS_REVIEW
  READY
  PUBLISHED
}

/// The four things a student can learn from a model essay. Deliberately closed:
/// the legend, the highlight colours and the learning panel all key off it, so
/// a fifth category is a schema change and a design decision, not a free-text
/// value someone can invent in an admin form.
enum IeltsEssayAnnotationCategory {
  GRAMMAR
  VOCABULARY
  COHESION
  COLLOCATION
}

/// Who put an annotation there. Kept because an admin needs to see at a glance
/// what the model claimed versus what a human added by hand.
enum IeltsAnnotationSource {
  AI
  ADMIN
}

model IeltsEssay {
  id        String @id @default(cuid())
  title     String
  /// The Task 2 prompt the essay answers.
  question  String @db.Text
  /// The essay exactly as the admin supplied it. Never rewritten — annotations
  /// are a layer of offsets over this string, so any edit invalidates them.
  essayText String @db.Text

  /// Always TASK_2. Stored rather than assumed so the constraint is visible in
  /// the data and a future Task 1 library cannot quietly land in this table.
  taskType String @default("TASK_2")

  /// 8.0, 8.5 or 9.0 only. Enforced by a CHECK constraint in the migration as
  /// well as in Zod — a band floor that lives only in a form is not a rule.
  band Float

  topic    String
  subtopic String?
  tags     String[] @default([])

  status IeltsEssayStatus @default(DRAFT)

  /// SHA-256 of `essayText` when the annotations were produced.
  ///
  /// Offsets point into an exact string. If an admin edits a single character
  /// every annotation after that point silently shifts, and a highlight lands
  /// on the wrong words — which teaches the student something false. Comparing
  /// this against the current text is how the UI knows to demand a re-analysis
  /// instead of rendering drifted highlights.
  analyzedTextHash String?
  /// Why the last analysis failed, for the admin. Never shown to students.
  analysisError    String?

  wordCount   Int       @default(0)
  publishedAt DateTime?

  createdById String?
  createdBy   User?   @relation("IeltsEssayAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  annotations IeltsEssayAnnotation[]
  ideas       IeltsEssayIdea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, band])
  @@index([topic])
  @@index([publishedAt])
}

/// One highlighted span. Offsets are character indices into
/// `IeltsEssay.essayText`, half-open [startOffset, endOffset), matching the
/// convention IeltsWritingAnnotation already uses for reviewer marks.
///
/// `quote` duplicates the span deliberately: it is the integrity check. If it
/// stops matching the text at those offsets, the annotation is stale and must
/// not be rendered.
model IeltsEssayAnnotation {
  id      String @id @default(cuid())
  essayId String

  category IeltsEssayAnnotationCategory
  /// Free text within a category — "relative_clause", "concessive_clause",
  /// "topic_specific", "contrast". Not an enum because the useful taxonomy is
  /// still being learned and an admin may type a better label than we guessed.
  subtype  String

  quote       String @db.Text
  startOffset Int
  endOffset   Int

  explanation String  @db.Text
  /// Why an IELTS candidate should care — the teaching, as opposed to the
  /// description.
  ieltsValue  String? @db.Text
  /// e.g. "play a crucial role in + noun/gerund". Only where a pattern is
  /// genuinely reusable.
  pattern     String?

  /// The model's own confidence. Null for anything a human wrote.
  confidence Float?
  source     IeltsAnnotationSource @default(AI)
  /// An admin has looked at this and kept it. Publishing requires every
  /// annotation to be reviewed.
  reviewed   Boolean               @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  essay IeltsEssay @relation(fields: [essayId], references: [id], onDelete: Cascade)

  @@index([essayId, category])
  @@index([essayId, startOffset])
}

/// A reusable argument lifted out of the essay.
///
/// Separate from annotations because an idea is not a span of text — it is a
/// claim the essay makes, which a student should be able to reuse on a
/// different question. Offsets are optional and only point at where the idea
/// surfaces, for the "jump to it in the essay" affordance.
model IeltsEssayIdea {
  id      String @id @default(cuid())
  essayId String

  claim       String  @db.Text
  explanation String  @db.Text
  consequence String? @db.Text
  /// Only when the essay actually contains one. The model is told not to
  /// invent examples.
  example     String? @db.Text

  startOffset Int?
  endOffset   Int?

  order    Int                   @default(0)
  source   IeltsAnnotationSource @default(AI)
  reviewed Boolean               @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  essay IeltsEssay @relation(fields: [essayId], references: [id], onDelete: Cascade)

  @@index([essayId])
}

// ---------------------------------------------------------------------------
// Research programme
// ---------------------------------------------------------------------------

enum ResearchProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// A student's application to the research programme: their topic, why it
/// matters to them, and what they already know. Reviewed by an admin; the
/// decision and note are shown back to the student.
model ResearchProposal {
  id         String                 @id @default(cuid())
  userId     String
  title      String
  field      String
  question   String                 @db.Text
  motivation String                 @db.Text
  experience String?                @db.Text
  status     ResearchProposalStatus @default(PENDING)
  adminNote  String?                @db.Text
  decidedAt  DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Peer-mentor programme
// ---------------------------------------------------------------------------

enum PeerMentorStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A student's application to become a peer mentor. One row per student —
/// re-applying after a rejection updates it — so "is this student an approved
/// mentor" is a single-row read, and that APPROVED status *is* the role that
/// unlocks hosting sessions.
model PeerMentorApplication {
  id        String           @id @default(cuid())
  userId    String           @unique
  headline  String
  bio       String           @db.Text
  satScore  Int?
  ieltsBand Float?
  subjects  String[]         @default([])
  telegram  String?
  /// [{ name, dataUrl }] — score-report uploads as inline data URIs, the same
  /// storage approach as question figures (no Blob token dependency).
  certificates Json          @default("[]")
  status    PeerMentorStatus @default(PENDING)
  adminNote String?          @db.Text
  decidedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ---------------------------------------------------------------------------
// Schools programme
// ---------------------------------------------------------------------------

/// A class a teacher runs, joined by students with a short code. Admin-created
/// during the pilot phase; the teacher is prose (name/contact) because pilot
/// teachers may not have accounts yet — `teacherUserId` links one later.
model SchoolClass {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  school        String
  teacherName   String
  teacherEmail  String?
  teacherUserId String?
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())

  teacher     User?             @relation("ClassTeacher", fields: [teacherUserId], references: [id], onDelete: SetNull)
  memberships ClassMembership[]

  @@index([teacherUserId])
}

model ClassMembership {
  id       String   @id @default(cuid())
  classId  String
  userId   String
  joinedAt DateTime @default(now())

  class SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId])
}
